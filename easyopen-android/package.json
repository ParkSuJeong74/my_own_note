{
  "name": "easyopen-android",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "start": "npm run sync:catalog && expo start",
    "android": "npm run sync:catalog && expo start --android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.cjs",
    "build": "npm run sync:catalog && expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@types/react": "~19.3.0",
    "expo": "^58.0.0",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "postcss": "^8.5.31"
  }
}

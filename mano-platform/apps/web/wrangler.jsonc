{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mano-platform",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "next.mano.io.kr",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}

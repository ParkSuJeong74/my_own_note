{
  "name": "mano-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MANO brand landing site — Cloudflare Pages static output",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node --check scripts/build.mjs && node --check tests/landing.test.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}

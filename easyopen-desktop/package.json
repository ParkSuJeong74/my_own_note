{
  "name": "easyopen-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EasyOpen desktop manager MVP (Windows first)",
  "main": "dist-electron/main.js",
  "scripts": {
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "dev": "npm run sync:catalog && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env EASYOPEN_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run sync:catalog && vite build && npm run build:electron",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "kr.io.mano.easyopen",
    "productName": "EasyOpen",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/catalog.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "EasyOpen-${version}-Setup.${ext}"
    }
  }
}

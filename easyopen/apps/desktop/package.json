{
  "name": "easyopen-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EasyOpen desktop manager MVP for macOS and Windows",
  "main": "dist-electron/main.js",
  "scripts": {
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "dev": "npm run sync:catalog && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env EASYOPEN_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "container-image:check": "node scripts/set-container-image.mjs",
    "container-image:set": "node scripts/set-container-image.mjs --apply",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run sync:catalog && vite build && npm run build:electron",
    "test": "node --import tsx --test tests/*.test.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64",
    "package:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 -c.mac.identity=null -c.mac.hardenedRuntime=false -c.mac.notarize=false"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "kr.io.mano.easyopen",
    "productName": "EasyOpen",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "resources/catalog.json",
      "resources/container-images.json",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "EasyOpen-${version}-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "artifactName": "EasyOpen-${version}-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "notarize": true
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}

{
  "name": "easyopen-account-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "migration:run": "node dist/database/migrate.js",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "verify:integration": "node scripts/verify-device-auth.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/typeorm": "^11",
    "typeorm": "^0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "jose": "^6.1.3",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24",
    "@types/express": "^5",
    "@types/cookie-parser": "^1.4.9"
  }
}
